{
  "name": "mappa-terrazze-sole",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pipeline:terraces": "tsx scripts/fetch-terraces.ts",
    "pipeline:terraces-mad": "tsx scripts/fetch-terraces-mad.ts",
    "pipeline:buildings": "tsx scripts/fetch-buildings.ts",
    "pipeline:heights": "tsx scripts/resolve-heights.ts",
    "pipeline:pois": "tsx scripts/fetch-osm-pois.ts",
    "pipeline:google": "tsx scripts/fetch-google-places.ts",
    "pipeline:discover": "tsx scripts/discover-places.ts",
    "pipeline:build": "tsx scripts/build-output.ts",
    "pipeline:bcn": "npm run pipeline:terraces && CITY=bcn npm run pipeline:buildings && CITY=bcn npm run pipeline:heights && CITY=bcn npm run pipeline:pois && CITY=bcn npm run pipeline:google && CITY=bcn npm run pipeline:build",
    "pipeline:mad": "npm run pipeline:terraces-mad && CITY=mad npm run pipeline:buildings && CITY=mad npm run pipeline:heights && CITY=mad npm run pipeline:pois && CITY=mad npm run pipeline:google && CITY=mad npm run pipeline:build",
    "pipeline:run": "npm run pipeline:bcn && npm run pipeline:mad"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "rbush": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.3",
    "suncalc": "^1.9.0",
    "zustand": "^5.0.13"
  }
}
